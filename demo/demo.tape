Output media/demo.gif
Set Shell "bash"
Set FontSize 16
Set Width 1360
Set Height 940
Set Framerate 5
Set Padding 12
Set Theme { "name": "Doom", "background": "#1A080A", "foreground": "#E0E0E0", "cursor": "#FF5C54", "selection": "#40151E", "black": "#1A080A", "red": "#FF3B30", "green": "#6EFF6E", "yellow": "#FFA500", "blue": "#00D9FF", "magenta": "#FF5C54", "cyan": "#00D9FF", "white": "#E0E0E0", "brightBlack": "#606060", "brightRed": "#FF5C54", "brightGreen": "#6EFF6E", "brightYellow": "#FFA500", "brightBlue": "#00D9FF", "brightMagenta": "#FF5C54", "brightCyan": "#00D9FF", "brightWhite": "#FFFFFF" }
Hide
Type "python3 demo/run.py wide"
Enter
Sleep 3s
Show
Sleep 4s
Ctrl+Q
Hide
Sleep 1s
Type "python3 demo/run.py narrow"
Enter
Sleep 3s
Show
Sleep 4s
Ctrl+Q
Hide
Sleep 1s
